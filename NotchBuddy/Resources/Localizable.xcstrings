    "Drop a file or window, or ask me anything." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "أسقط ملفاً أو نافذة، أو اسألني أي شيء." } },
        "bn" : { "stringUnit" : { "state" : "translated", "value" : "একটি ফাইল বা উইন্ডো ড্রপ করুন, অথবা যেকোনো কিছু জিজ্ঞেস করুন।" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Suelta un archivo o ventana, o pregúntame cualquier cosa." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Dépose un fichier ou une fenêtre, ou demande-moi n'importe quoi." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "कोई फ़ाइल या विंडो ड्रॉप करें, या कुछ भी पूछें।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Seret file atau jendela, atau tanya apa saja." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Solte um arquivo ou janela, ou me pergunte qualquer coisa." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перетащите файл или окно, или спросите меня что угодно." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拖入文件或窗口，或问我任何问题。" } }
      }
    },

