    "Gmail node timed out after 30s. Retry or open n8n." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "انتهت مهلة عقدة Gmail بعد 30 ثانية. أعد المحاولة أو افتح n8n." } },
        "bn" : { "stringUnit" : { "state" : "translated", "value" : "Gmail নোড 30 সেকেন্ড পরে টাইম আউট হয়েছে। পুনরায় চেষ্টা করুন বা n8n খুলুন।" } },
